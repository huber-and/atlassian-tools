@startuml process_flow
!theme plain
title Wiki Publisher - Processing Flow

skinparam backgroundColor #FAFAFA
skinparam activityBackgroundColor #E8F4F8
skinparam activityBorderColor #0066CC
skinparam arrowColor #333333

start

:Load Configuration;

:Initialize Publisher
  - Resolve Parser class from parserClass
    (without initializing it)
  - Reject anything that is not a Parser
  - Instantiate and call init(config);

partition "Phase 1: parse" {
  :For each configured Space Mapper;

  :Parse Source Documentation
    - Read index.html
    - Extract page hierarchy;

  :Resolve Pages
    - Create Page tree structure
    - Load page source paths;

  :Log Page Hierarchy;

  :Next mapper;
}

:Build Link Index
  - Combine the page trees of all mappers
  - Enables cross-space links by title and space key;

:Create ConfluenceTransformer and ConfluenceClient;

partition "Phase 2: publish" {
  :For each configured Space Mapper;

  :For each Page (recursively);

:Get or Create Page in Confluence
  - Check if exists
  - Create if not found;

:Load Page Content;

:Transform Content
  - Parse HTML
  - Resolve internal links via the link index
  - Convert admonitions and code blocks
  - Convert to Confluence storage format
  - Extract attachments;

:Update Page Body
  - Apply transformation
  - Set page properties;

:Upload Attachments
  - For each attachment
  - Upload to Confluence;

:Process Child Pages (recursive);

:End of page processing;

  :Clean Up Orphans
    - Find pages below root that no longer exist locally
    - Move to trash, or report only
      when deleteOrphans is disabled;

  :Next mapper;
}

:End of publisher;

:Handle Errors
  - Log failures
  - Continue with next mapper;

stop

@enduml
